# ─── Alkarma Bookstore — environment template ────────────────────────────────
# Copy to .env.local and fill in. Never commit real values.

# ─── Database (Alkarma's OWN Supabase project — NOT shared with any other) ───
# Transaction pooler (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct / session pooler (port 5432) — required by Prisma for migrate & db push.
DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# ─── Auth ───────────────────────────────────────────────────────────────────
# NextAuth v5 reads AUTH_* (the NEXTAUTH_* names are the v4 fallback).
# Generate the secret with: openssl rand -base64 32
AUTH_SECRET=""
# Canonical origin. Also used to build password-reset links in emails, so it
# must be the real domain in production — not a preview URL.
AUTH_URL="http://localhost:3000"

# Google sign-in. Both are asserted non-null in src/lib/auth.ts, so set them
# (even to empty strings) rather than omitting them.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://alkarmabooks.com"
NEXT_PUBLIC_APP_NAME="الكرمة"

# ─── Shipping (EGP only) ────────────────────────────────────────────────────
# Fallback flat rate, used ONLY if no ShippingZone/ShippingRate rows exist.
# Real per-governorate rates are seeded by scripts/seed-shipping.ts.
# There is no free-shipping threshold — the store does not offer free shipping.
SHIPPING_FLAT_RATE_EGP=""

# ─── Transactional email (Alkarma's OWN sender — do not reuse another store's)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ─── Images: Vercel Blob ────────────────────────────────────────────────────
# Intentionally the SAME Blob store as the sibling bookstore project; wired up
# via Vercel → Storage → the existing Blob store → "Connect Project".
# Vercel injects this automatically once connected; set it locally for scripts.
BLOB_READ_WRITE_TOKEN=""

# ─── Misc ───────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER="cod"
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="5242880"

# ─── Analytics ──────────────────────────────────────────────────────────────
# Alkarma's OWN Google Tag Manager container (e.g. GTM-XXXXXXX).
# Leave empty to disable GTM. Never reuse another store's container — doing so
# sends this store's traffic and ecommerce events into their analytics.
NEXT_PUBLIC_GTM_ID=""

# ─── Cloudflare Turnstile (bot protection on register / forgot-password) ────
# Leaving these unset disables the challenge rather than blocking the forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── Cron ───────────────────────────────────────────────────────────────────
# Shared secret for /api/cron/*. The route REJECTS every request when this is
# unset, so the weekly external-reviews refresh silently never runs without it.
CRON_SECRET=""

# ─── Optional integrations ──────────────────────────────────────────────────
# External review sources. Both are optional; each degrades to "no reviews
# from that source" rather than erroring.
GOOGLE_BOOKS_API_KEY=""
NYT_BOOKS_API_KEY=""

# Where low-stock and other admin alerts go. Falls back to SMTP_FROM, then to
# the store's contact address.
ADMIN_ALERT_EMAIL=""
