# ─── Alkarma Bookstore — environment template ────────────────────────────────
# Copy to .env.local and fill in. Never commit real values.

# ─── Database (Alkarma's OWN Supabase project — NOT shared with any other) ───
# Transaction pooler (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct / session pooler (port 5432) — required by Prisma for migrate & db push.
DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://alkarmabooks.com"
NEXT_PUBLIC_APP_NAME="الكرمة"

# ─── Shipping (EGP only) ────────────────────────────────────────────────────
# Fallback flat rate, used ONLY if no ShippingZone/ShippingRate rows exist.
# Real per-governorate rates are seeded by scripts/seed-shipping.ts.
# There is no free-shipping threshold — the store does not offer free shipping.
SHIPPING_FLAT_RATE_EGP=""

# ─── Transactional email (Alkarma's OWN sender — do not reuse another store's)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ─── Images: Vercel Blob ────────────────────────────────────────────────────
# Intentionally the SAME Blob store as the sibling bookstore project; wired up
# via Vercel → Storage → the existing Blob store → "Connect Project".
# Vercel injects this automatically once connected; set it locally for scripts.
BLOB_READ_WRITE_TOKEN=""

# ─── Misc ───────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER="cod"
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="5242880"

# ─── Analytics ──────────────────────────────────────────────────────────────
# Alkarma's OWN Google Tag Manager container (e.g. GTM-XXXXXXX).
# Leave empty to disable GTM. Never reuse another store's container — doing so
# sends this store's traffic and ecommerce events into their analytics.
NEXT_PUBLIC_GTM_ID=""
